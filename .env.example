# ==============================================================================
# 1. AGENT RUNNER INFRASTRUCTURE (Vertex AI LLM & Firestore Storage)
# ==============================================================================
# Your Google Cloud Project used to run the agent, Vertex AI models, and Firestore
GOOGLE_CLOUD_PROJECT="your-agent-runner-gcp-project"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GENAI_USE_VERTEXAI="true"

# Firestore database & collection for saving audit history and scorecards
FIRESTORE_DATABASE="looker-healthcheck-db"
FIRESTORE_COLLECTION="looker_healthchecks"

# ==============================================================================
# 2. TARGET LOOKER INSTANCE (Zero-Secret OAuth with looker-cli)
# ==============================================================================
# The agent automatically inherits host and session tokens from ~/.config/looker-cli/config.yaml
# Run `looker-cli session login --oauth --client-id com.looker.cli` once in your terminal.
# No API3 client_id or client_secret needed in .env.
LOOKER_CLI_PATH="looker-cli"

# All LookML code (views, models, explores) is streamed LIVE from the Looker instance
# via `looker-cli` over Zero-Secret User OAuth. Zero local files or git clones required.

# ==============================================================================
# 3. TARGET BIGQUERY DATA WAREHOUSE (The Project under Review)
# ==============================================================================
# The GCP Project, Dataset, and Region where the Looker instance's data resides.
# (Can be different from GOOGLE_CLOUD_PROJECT above)
TARGET_BIGQUERY_PROJECT="your-target-customer-warehouse-project"
TARGET_BIGQUERY_DATASET="the_look_ca"
TARGET_BIGQUERY_LOCATION="US"

# Optional: Dedicated Google Account email for BigQuery (if different from ADC runner identity)
# TARGET_BIGQUERY_ACCOUNT="sampitcher@google.com"


