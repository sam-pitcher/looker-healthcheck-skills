# ==============================================================================
# 1. TARGET LOOKER INSTANCE (Zero-Secret OAuth with looker-cli)
# ==============================================================================
# The harness interacts with Looker via `looker-cli`.
# Inherited automatically from ~/.config/looker-cli/config.yaml
# Authenticate once: looker-cli session login --oauth --client-id com.looker.cli
LOOKER_CLI_PROFILE="default"

# ==============================================================================
# 2. TARGET BIGQUERY DATA WAREHOUSE
# ==============================================================================
# The GCP Project, Dataset, and Region where the Looker instance's warehouse data resides.
# Used by standard `bq` CLI commands and INFORMATION_SCHEMA queries.
TARGET_BIGQUERY_PROJECT="your-target-bigquery-project"
TARGET_BIGQUERY_DATASET="your_dataset"
TARGET_BIGQUERY_LOCATION="US"



