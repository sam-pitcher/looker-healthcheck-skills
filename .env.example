# ==============================================================================
# Looker Authentication & Instance Configuration
# ==============================================================================
# Recommended: Zero-Secret OAuth PKCE Mode (No API keys or project IDs in .env needed)
# Run `looker-cli session login --oauth --client-id com.looker.cli` once in your terminal.
# The agent dynamically inherits your user identity and session tokens from ~/.config/looker-cli/config.yaml.
# Projects and models are dynamically discovered (via `list_projects()`) or discussed in chat.

# Optional: Override Looker Base URL (if not using looker-cli host profile)
# LOOKERSDK_BASE_URL="https://your-company.looker.com"

# Optional: Headless CI/CD Service Account Credentials (Only needed for automated pipelines without an active user session)
# LOOKERSDK_CLIENT_ID="your_client_id_here"
# LOOKERSDK_CLIENT_SECRET="your_client_secret_here"

# SSL/TLS Verification (Set to "false" only for self-signed development instances)
LOOKER_VERIFY_SSL="true"

# ==============================================================================
# Local LookML Repository & Developer Tooling
# ==============================================================================
# Optional Default Local LookML Repository (Can also be specified dynamically via chat)
# LOOKML_PROJECT_PATH="/path/to/your/lookml/repo"

# Optional: Path to looker-cli binary for local compilation diagnostics
LOOKER_CLI_PATH="looker-cli"

# ==============================================================================
# Google Cloud Vertex AI & Firestore Datastore
# ==============================================================================
# GCP Project ID for Vertex AI LLM execution & Firestore telemetry storage
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GENAI_USE_VERTEXAI="true"

# Firestore database and collection for persisting healthcheck runs & trends
FIRESTORE_DATABASE="looker-healthcheck-db"
FIRESTORE_COLLECTION="looker_healthchecks"
